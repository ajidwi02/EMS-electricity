<IfModule mod_rewrite.c>
  RewriteEngine On

  # URL pendek tanpa index.php — mendukung vhost (http://electrical/dashboard)
  # maupun subfolder (http://[::1]/electrical/dashboard).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
  ErrorDocument 404 /index.php
</IfModule>
